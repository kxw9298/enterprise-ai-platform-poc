// Log Analytics workspace schema (AppTraces). Dated retail estimate, not invoice.
// Snapshot: pricing/gpt-4.1-mini-global-2026-10-25.json, USD per million tokens.
// Outside the observed local-day window or model/version, cost stays null.
// The APIM trace stores its dimensions as a JSON blob in the Properties column.
// The Application Insights portal Logs blade instead presents this same data as
// `traces`/`customDimensions`; use that form there, not this one.
let InputUSDPerMillion = 0.40;
let CachedInputUSDPerMillion = 0.10;
let OutputUSDPerMillion = 1.60;
let PriceWindowStart = datetime(2026-10-25T04:00:00Z);
let PriceWindowEnd = datetime(2026-10-26T04:00:00Z);
AppTraces
| where TimeGenerated > ago(24h) and Message == "Model usage"
| extend P = parse_json(Properties)
| extend SubscriptionId=tostring(P.subscription_id), ClientId=tostring(P.client_id), RequestId=tostring(P.request_id),
         Deployment=tostring(P.deployment), Model=tostring(P.model),
         ModelVersion=tostring(P.model_version), Usage=parse_json(tostring(P.usage))
| where isnotempty(RequestId) and isnotempty(SubscriptionId)
// Deduplicate repeated telemetry, not actual separate model requests.
| summarize arg_max(TimeGenerated, *) by RequestId
| extend InputTokens=tolong(Usage.prompt_tokens), OutputTokens=tolong(Usage.completion_tokens),
         CachedTokens=coalesce(tolong(Usage.prompt_tokens_details.cached_tokens), 0)
| extend MissingUsage=isnull(InputTokens) or isnull(OutputTokens)
| extend PriceApplies=Model == "gpt-4.1-mini" and ModelVersion startswith "2025-04-14"
    and TimeGenerated >= PriceWindowStart and TimeGenerated < PriceWindowEnd
| summarize Requests=count(), MissingUsageRequests=countif(MissingUsage),
            UnpricedRequests=countif(not(PriceApplies)),
            InputTokens=sum(InputTokens), CachedInputTokens=sum(CachedTokens), OutputTokens=sum(OutputTokens)
            by SubscriptionId, Deployment, Model, ModelVersion
| extend EstimatedModelUSD=iff(MissingUsageRequests > 0 or UnpricedRequests > 0, real(null),
    ((InputTokens-CachedInputTokens)*InputUSDPerMillion + CachedInputTokens*CachedInputUSDPerMillion + OutputTokens*OutputUSDPerMillion)/1000000.0)
// Includes successful non-streaming calls only. Inspect failed gateway requests
// separately; incomplete telemetry cannot establish a complete invoice.
// Excludes Copilot credits/licenses, AKS, APIM and other shared infrastructure.
