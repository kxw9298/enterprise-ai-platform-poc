<policies>
  <inbound>
    <base />
    <validate-azure-ad-token tenant-id="${tenant_id}" header-name="Authorization" failed-validation-httpcode="401" output-token-variable-name="caller">
      <client-application-ids>
%{ for client_id in client_ids ~}
        <application-id>${client_id}</application-id>
%{ endfor ~}
      </client-application-ids>
      <audiences><audience>${audience}</audience></audiences>
    </validate-azure-ad-token>
    <set-variable name="clientId" value='@(((Jwt)context.Variables["caller"]).Claims.GetValueOrDefault("azp", ((Jwt)context.Variables["caller"]).Claims.GetValueOrDefault("appid", "unknown")))' />
    <set-header name="x-client-id" exists-action="override"><value>@((string)context.Variables["clientId"])</value></set-header>
    <choose>
      <when condition='@(context.Request.Body.As&lt;JObject&gt;(preserveContent: true).Value&lt;bool?&gt;("stream") == true)'>
        <return-response><set-status code="400" reason="Initial accounting test requires non-streaming requests" /></return-response>
      </when>
    </choose>
    <rate-limit-by-key calls="${requests_per_minute}" renewal-period="60" counter-key='@("model-requests:" + (string)context.Variables["clientId"])' />
    <llm-token-limit counter-key='@("model-tokens:" + (string)context.Variables["clientId"])' tokens-per-minute="${tokens_per_minute}" token-quota="${daily_token_quota}" token-quota-period="Daily" estimate-prompt-tokens="false" />
    <llm-emit-token-metric namespace="POC.ModelUsage">
      <dimension name="ClientId" value='@((string)context.Variables["clientId"])' />
      <dimension name="Deployment" value="${deployment}" />
    </llm-emit-token-metric>
    <rewrite-uri template="/openai/deployments/${deployment}/chat/completions" copy-unmatched-params="false" />
    <set-query-parameter name="api-version" exists-action="override"><value>2024-10-21</value></set-query-parameter>
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
  </inbound>
  <backend><forward-request buffer-response="false" /></backend>
  <outbound>
    <base />
    <choose>
      <when condition='@(context.Response.StatusCode == 200)'>
        <set-variable name="usage" value='@(context.Response.Body.As&lt;JObject&gt;(preserveContent: true)["usage"]?.ToString(Newtonsoft.Json.Formatting.None) ?? "{}")' />
        <trace source="poc-model-usage" severity="information">
          <message>Model usage</message>
          <metadata name="client_id" value='@((string)context.Variables["clientId"])' />
          <metadata name="request_id" value="@(context.RequestId.ToString())" />
          <metadata name="deployment" value="${deployment}" />
          <metadata name="model" value="gpt-4.1-mini" />
          <metadata name="model_version" value="2025-04-14" />
          <metadata name="usage" value='@((string)context.Variables["usage"])' />
        </trace>
      </when>
    </choose>
  </outbound>
  <on-error><base /></on-error>
</policies>
